---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import { getTranslations } from '../../i18n';

const locale = 'en';
const t = getTranslations(locale);
---

<BaseLayout locale={locale} title={t['seo.title']} description={t['seo.description']}>
  <Header locale={locale} />
  <main class="flex flex-col items-center justify-center min-h-[80dvh] px-6">
    <h1 class="text-4xl font-bold">{t['hero.title']}</h1>
    <p class="mt-4 text-[var(--color-text-muted)] max-w-xl text-center">{t['hero.subtitle']}</p>
  </main>
</BaseLayout>
