---
import '../styles/global.css';

interface Props {
  locale: 'es' | 'en';
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Font preload -->
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/geist-regular.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/geist-bold.woff2" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- FOUC prevention: runs before first paint -->
    <script is:inline>
      const t = localStorage.getItem('theme');
      const d = t ? t === 'dark' : matchMedia('(prefers-color-scheme:dark)').matches;
      if (d) document.documentElement.classList.add('dark');
    </script>
  </head>
  <body class="bg-[var(--color-bg)] text-[var(--color-text)] min-h-screen transition-[background-color,color] duration-200">
    <slot />
  </body>
</html>
