---
import type { Dictionary } from '../i18n';
import { SOCIAL } from '../data/social';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<footer class="px-6 py-8 border-t border-[var(--color-border)]">
  <div class="max-w-4xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
    <p class="text-sm text-[var(--color-text-muted)]">
      <span data-i18n-copyright>{t['footer.copyright']}</span>
    </p>
    <div class="flex items-center gap-4">
      <a
        href={SOCIAL.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub (opens in new tab)"
        class="animated-link text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors duration-200"
      >
        GitHub
      </a>
      <a
        href={SOCIAL.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn (opens in new tab)"
        class="animated-link text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors duration-200"
      >
        LinkedIn
      </a>
    </div>
  </div>
</footer>

<script is:inline>
  (function() {
    var el = document.querySelector('[data-i18n-copyright]');
    if (el) {
      el.textContent = el.textContent.replace('{year}', new Date().getFullYear());
    }
  })();
</script>
