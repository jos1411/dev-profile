---
import type { Dictionary } from '../../i18n';
import TerminalTypewriter from '../TerminalTypewriter.astro';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section class="flex flex-col items-center justify-center min-h-[80vh] px-6 py-20 text-center">
  <h1 class="text-4xl md:text-6xl font-bold max-w-3xl leading-tight">
    {t['hero.title']}
  </h1>
  <p class="mt-6 text-lg md:text-xl text-[var(--color-text-muted)] max-w-2xl">
    {t['hero.subtitle']}
  </p>
  <div class="mt-8 w-full max-w-xl">
    <TerminalTypewriter text={t['terminal.text']} />
  </div>
  <a
    href="#contact"
    class="mt-10 inline-block px-8 py-3 bg-[var(--color-accent)] text-white font-medium rounded-lg hover:bg-[var(--color-accent-hover)] transition-colors duration-200"
  >
    {t['hero.cta']}
  </a>
</section>
