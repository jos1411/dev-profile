---
import type { Dictionary } from '../../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;

const education = [
  {
    degree: t['education.1.degree'],
    school: t['education.1.school'],
    detail: t['education.1.detail'],
  },
  {
    degree: t['education.2.degree'],
    school: t['education.2.school'],
    detail: t['education.2.detail'],
  },
  {
    degree: t['education.3.degree'],
    school: t['education.3.school'],
    detail: t['education.3.detail'],
  },
];
---

<section class="px-6 py-20 max-w-4xl mx-auto">
  <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center">
    {t['education.title']}
  </h2>
  <div class="grid gap-6 md:grid-cols-3">
    {education.map((edu) => (
      <article class="flex flex-col p-6 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-alt)]">
        <h3 class="text-lg font-bold mb-2">{edu.degree}</h3>
        <p class="text-sm text-[var(--color-accent)] mb-2">{edu.school}</p>
        <p class="text-sm text-[var(--color-text-muted)]">{edu.detail}</p>
      </article>
    ))}
  </div>
</section>
