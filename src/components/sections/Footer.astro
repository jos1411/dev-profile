---
import type { Dictionary } from '../../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const year = new Date().getFullYear();
const copyrightText = t['footer.copyright'].replace('{year}', String(year));
---

<footer class="px-6 py-8 border-t border-[var(--color-border)]">
  <div class="max-w-4xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
    <p class="text-sm text-[var(--color-text-muted)]">
      {copyrightText}
    </p>
    <div class="flex items-center gap-4">
      <a
        href="https://github.com/jos1411"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub (opens in new tab)"
        class="animated-link text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors duration-200"
      >
        GitHub
      </a>
      <a
        href="https://www.linkedin.com/in/jos%C3%A9-daniel-monge-varela-99515a412"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn (opens in new tab)"
        class="animated-link text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors duration-200"
      >
        LinkedIn
      </a>
    </div>
  </div>
</footer>
