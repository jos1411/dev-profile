---
import type { Dictionary } from '../../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;

const experiences = [
  {
    role: t['experience.1.role'],
    company: t['experience.1.company'],
    period: t['experience.1.period'],
    detail: t['experience.1.detail'],
    bullets: undefined as string[] | undefined,
  },
  {
    role: t['experience.2.role'],
    company: t['experience.2.company'],
    period: t['experience.2.period'],
    detail: t['experience.2.detail'],
    bullets: [t['experience.2.bullet.1'], t['experience.2.bullet.2']],
  },
];
---

<section id="experience" class="px-6 py-20 max-w-4xl mx-auto">
  <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center">
    {t['experience.title']}
  </h2>
  <div class="relative">
    <div class="absolute left-4 top-0 bottom-0 w-px bg-[var(--color-border)]"></div>
    <div class="space-y-10">
      {experiences.map((exp) => (
        <div class="relative pl-12">
          <div class="absolute left-2.5 top-1.5 w-3 h-3 rounded-full border-2 border-[var(--color-accent)] bg-[var(--color-bg)]"></div>
          <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-1 mb-2">
            <h3 class="text-lg font-bold">{exp.role}</h3>
            <span class="text-xs font-mono text-[var(--color-text-muted)]">{exp.period}</span>
          </div>
          {exp.company && (
            <p class="text-sm text-[var(--color-accent)] mb-2">{exp.company}</p>
          )}
          {exp.bullets ? (
            <ul class="space-y-1.5 mt-2">
              {exp.bullets.map((bullet) => (
                <li class="flex items-start gap-2">
                  <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-[var(--color-accent)] flex-shrink-0 opacity-60"></span>
                  <span class="text-sm text-[var(--color-text-muted)]">{bullet}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-sm text-[var(--color-text-muted)]">{exp.detail}</p>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
