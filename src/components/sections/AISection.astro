---
import type { Dictionary } from '../../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;

const tools = [
  t['ai.tool.1'],
  t['ai.tool.2'],
  t['ai.tool.3'],
  t['ai.tool.4'],
];
---

<section class="px-6 py-20 max-w-3xl mx-auto">
  <h2 class="text-3xl md:text-4xl font-bold mb-6">
    {t['ai.title']}
  </h2>
  <p class="text-lg text-[var(--color-text-muted)] leading-relaxed mb-8">
    {t['ai.description']}
  </p>
  <div class="grid gap-4 md:grid-cols-2">
    {tools.map((tool) => (
      <div class="p-4 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-alt)]">
        <p class="text-sm text-[var(--color-text-muted)]">{tool}</p>
      </div>
    ))}
  </div>
</section>
